# The same test with the guest's memory in files (DM_GUEST_FILE, hle_svc.c), one file and then 64 MB files, made in the build folder; its last line says how many files held it
# (0: the files could not be made there, and the guest stayed anonymous)
GUEST_FILE_ENV = DM_GUEST_FILE=1 DM_GUEST_FILE_MIN_FREE=0 DM_GUEST_FILE_DIR="$(abspath $(B))"
.PHONY: memory-file
memory-file: $(B)/t_svc_memory $(B)/t_svc_memory_16k
	$(GUEST_FILE_ENV) $(B)/t_svc_memory
	$(GUEST_FILE_ENV) DM_GUEST_FILE_CHUNK=64M $(B)/t_svc_memory
	$(GUEST_FILE_ENV) DM_GUEST_FILE_CHUNK=64M $(B)/t_svc_memory_16k
run: memory memory-dirty memory-profile memory-file

# A native blocking notification wait must release the thread's guest core.
$(B)/t_notify_sched: t_notify_sched.c t_condvar_stub.c ../hle_thread.c ../hle_oe.c ../hle.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -DDM_TEST_THREAD_ENTER -I.. $(GINC) -o $@ t_notify_sched.c t_condvar_stub.c
.PHONY: notify-scheduler
notify-scheduler: $(B)/t_notify_sched
	$(B)/t_notify_sched
	$(B)/t_notify_sched --all-peers
run: notify-scheduler

# Sanitizer builds (../../sanitizers/sanitizers.mk): make asan runs every test of run under ASan and UBSan; make tsan-threads runs the tests that start threads under TSan
# (t_audio_spsc, t_hid and t_svc_memory have their own TSan targets above: tsan, memory-tsan)
include ../../sanitizers/sanitizers.mk
.PHONY: asan tsan-threads tsan-threads-run
asan:
	@$(call san_fresh,$(B)/asan,$(ASAN_FLAGS))
	$(ASAN_ENV) $(MAKE) B=$(B)/asan SAN="$(ASAN_FLAGS)" run
TSAN_T = t_audio t_audio_stats t_audio_device t_thread_leak t_oe t_fs_commit_list t_fs_case t_save_sync t_condvar t_condvar_old t_preempt t_system_event t_notify_sched t_altstack
tsan-threads:
	@$(call san_fresh,$(B)/tsan,$(TSAN_FLAGS))
	$(TSAN_ENV) $(MAKE) B=$(B)/tsan SAN="$(TSAN_FLAGS)" tsan-threads-run
tsan-threads-run: $(addprefix $(B)/,$(TSAN_T))
	$(B)/t_audio
	$(B)/t_audio_stats
	$(B)/t_audio_device
	$(B)/t_thread_leak
	$(B)/t_oe
	TMPDIR="$(abspath $(B))" $(B)/t_fs_commit_list
	TMPDIR="$(abspath $(B))" $(B)/t_fs_case
	TMPDIR="$(abspath $(B))" $(B)/t_save_sync
	$(B)/t_condvar
	$(B)/t_condvar_old
	$(B)/t_preempt
	$(B)/t_preempt --all-peers
	$(B)/t_system_event
	$(B)/t_notify_sched
	$(B)/t_notify_sched --all-peers
	$(B)/t_altstack
	DM_QOS_MAP=1 $(B)/t_notify_sched
	DM_QOS_MAP=1 $(B)/t_notify_sched --all-peers
$(B)/t_pad_hid: t_pad_hid.c ../pad_hid.h ../dm_input.h | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -fsanitize=address,undefined -I.. -o $@ t_pad_hid.c

# Line coverage (../../sanitizers/coverage.mk): make coverage builds every test of run into $(B)/cov with COV_FLAGS, runs them and writes $(B)/cov/coverage.lcov.
# It measures, it does not test: make -i runs every test even after one fails (the plain run reports that), so the coverage of the others is kept.
include ../../sanitizers/coverage.mk
.PHONY: coverage
coverage:
	@$(call san_fresh,$(B)/cov,$(COV_FLAGS))
	rm -rf $(B)/cov/prof
	LLVM_PROFILE_FILE="$(call cov_profile,$(B)/cov)" $(MAKE) -i B=$(B)/cov SAN="$(COV_FLAGS)" run
	@$(call cov_export,$(B)/cov)

# Build the synthetic guest with the selected rewrite ABI and run its two-thread SVC round trip.
# Android CI uses an NDK compiler, static bionic and qemu-aarch64. The same binary runs directly on an arm64 Android device.
GATE_ABI ?= apple
GATE_SEGMENT_ALIGN ?= 16384
GATE_CC ?= $(CLANG)
GATE_LOADER_FLAGS = $(if $(filter android,$(GATE_ABI)),-D_GNU_SOURCE -I../../android/compat ../../android/compat/sha256.c,-Wno-deprecated-declarations)
GATE_GC = $(if $(filter android,$(GATE_ABI)),-Xlinker --gc-sections,-Xlinker -dead_strip)
GATE_RUNNER ?=
.PHONY: gate-build gate-test
gate-build: $(GAME_H)
	mkdir -p "$(B)/gate-$(GATE_ABI)"
	DM_GAME=$(GAME) $(PYTHON) gate/fixture.py $(GATE_ABI) "$(B)/gate-$(GATE_ABI)" $(GATE_SEGMENT_ALIGN)
	$(GATE_CC) -O1 -Wall -Werror -pthread $(GINC) $(GATE_LOADER_FLAGS) -I.. -ffunction-sections -fdata-sections $(GATE_GC) gate/roundtrip.c gate/bootstrap.c ../../android/cli/front_cli.c ../probe_text.c ../hle_count.c ../thread.c ../entry.S ../hle.c ../hle_os.c ../hle_time.c ../loader.c ../crash.c -ldl -o "$(B)/gate-$(GATE_ABI)/roundtrip"
gate-test: gate-build
	DM_HLECOUNT="$(abspath $(B))/gate-$(GATE_ABI)/calls.tsv" $(GATE_RUNNER) "$(B)/gate-$(GATE_ABI)/roundtrip" "$(B)/gate-$(GATE_ABI)"
	$(PYTHON) gate/check_counts.py "$(B)/gate-$(GATE_ABI)/calls.tsv"
	ulimit -c 0; $(PYTHON) gate/reject_foreign.py $(GATE_ABI) "$(B)/gate-$(GATE_ABI)" $(GATE_RUNNER) "$(B)/gate-$(GATE_ABI)/roundtrip"
