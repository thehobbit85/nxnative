# dm/host unit tests in one command: make -C dm/host/tests GAME=<base game title ID> run (takes seconds; build output goes to build/ and is not committed)
B = build
PYTHON ?= python3
# SAN: extra compiler flags for a sanitizer or coverage build (make asan, make tsan-threads and make coverage below set it, with B = a build folder of their own); empty otherwise
SAN ?=
CLANG = clang $(SAN)
# stderr that the plain run hides is kept in sanitizer builds: the sanitizers report there
QUIET = $(if $(findstring -fsanitize,$(SAN)),,2>/dev/null)
.DEFAULT_GOAL := run
run: jit-memory
.PHONY: jit-memory
jit-memory: $(B)/t_jit_memory
	$(B)/t_jit_memory
$(B)/t_jit_memory: t_jit_memory.c ../jit_memory.h | $(B)
	$(CLANG) -O1 -Wall -Werror -pthread -D_GNU_SOURCE -o $@ $<
# game profile header (dm.h needs game_profile.h, generated by the host Makefile into ../gen/<profile>/)
# tests that use the game profile need GAME=<base game title ID> (there is no default game); GINC only expands when used, so tests without the profile build as before
GINC = $(if $(strip $(GAME)),-I../gen/$(GAME) -I../../games/$(GAME),$(error GAME is not set: make GAME=<base game title ID>: $(shell python3 ../../games/game.py list | awk -F'\t' '{printf "%s (%s)  ", $$1, $$3}')))
$(B)/t_fs $(B)/t_fs_case $(B)/t_fs_commit_list $(B)/t_fs_commit_list_tsan: ../romfs_image.h
$(B)/t_fs $(B)/t_fs_case $(B)/t_fs_directory $(B)/t_fs_commit_list $(B)/t_fs_commit_list_tsan $(B)/t_save_sync $(B)/t_save_sync_metadata: ../save_fs.h
GAME_H = ../gen/$(GAME)/game_profile.h
.PHONY: probe-poll android-probe-poll-build
run: probe-poll
probe-poll: $(B)/t_probe_poll
	$(B)/t_probe_poll
$(B)/t_probe_poll: t_probe_poll.c ../probe.c ../host_memory.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ $<
android-probe-poll-build: $(B)/t_probe_poll_android
$(B)/t_probe_poll_android: t_probe_poll.c ../probe.c ../host_memory.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -D_GNU_SOURCE -Wall -Werror -Wno-format -Wno-unused-function -I.. -I../../android/compat $(GINC) -o $@ $<
.PHONY: jit android-jit-build
run: jit
jit: $(B)/t_jit
	$(B)/t_jit $(QUIET)
	$(B)/t_jit "$(abspath $(B))/capture-$$$$" $(QUIET)
JIT_HEADERS = ../loader.c ../hle_jit.c ../jit_memory.h ../hle.h ../dm.h $(GAME_H)
$(B)/t_jit: t_jit.c $(JIT_HEADERS) | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -Wno-deprecated-declarations -I.. $(GINC) -o $@ $<
android-jit-build: $(B)/t_jit_android $(B)/t_jit_memory
$(B)/t_jit_android: t_jit.c $(JIT_HEADERS) ../android_text.h ../../android/compat/sha256.c ../../android/compat/CommonCrypto/CommonDigest.h | $(B)
	$(CLANG) -O1 -g -D_GNU_SOURCE -Wall -Werror -Wno-format -Wno-unused-function -I.. -I../../android/compat $(GINC) -o $@ $< ../../android/compat/sha256.c
run: $(B)/t_net_eventfd $(B)/t_language $(B)/t_motion $(B)/t_heap_size $(B)/t_touch $(B)/t_gesture $(B)/t_oe $(B)/t_fs $(B)/t_fs_commit_list $(B)/t_thread_leak $(B)/t_fs_case $(B)/t_audio $(B)/t_output_stream $(B)/t_audio_spsc $(B)/t_swkbd $(B)/t_altstack $(B)/t_condvar $(B)/t_condvar_old $(B)/t_pollwait $(B)/t_pctl $(B)/t_sf $(B)/t_time $(B)/t_shared_font $(B)/t_vorbis $(B)/t_vorbis_divides $(B)/t_hid $(B)/t_haptics $(B)/t_haptics_apple $(B)/t_cheats $(B)/t_pad_hid
