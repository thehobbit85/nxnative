	$(CLANG) -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_fs.c t_fs_stub.c ../hle_bigstack.c ../save_sync.c
# Android arm64: pass the NDK aarch64-linux-android<api>-clang as CLANG. Native
# ARM64 Linux CI runs the static binaries on its own filesystem. To check Android
# bionic, SELinux and /data, build without -static, adb push the three executables
# from $(B)/android-fs/ and run each with TMPDIR in a private /data/local/tmp subdirectory.
ANDROID_FS_TESTS = t_fs t_fs_commit_list t_save_sync
ANDROID_FS_SRC = t_fs_stub.c ../hle_bigstack.c ../save_sync.c ../save_fs_linux.c ../../android/compat/sha256.c
ANDROID_FS_FLAGS = -O1 -Wall -Werror -Wno-unused-function -I.. -I../../android/compat $(GINC)
ANDROID_FS_HEADERS = ../hle.h ../dm.h ../save_fs.h ../save_sync.h ../romfs_image.h ../../android/compat/CommonCrypto/CommonDigest.h
.PHONY: android-fs-build
android-fs-build: $(B)/android-fs/hle_fs.o $(addprefix $(B)/android-fs/,$(ANDROID_FS_TESTS))
$(B)/android-fs:
	mkdir -p $@
$(B)/android-fs/hle_fs.o: ../hle_fs.c $(ANDROID_FS_HEADERS) $(GAME_H) | $(B)/android-fs
	$(CLANG) $(ANDROID_FS_FLAGS) -fPIC -c $< -o $@
$(addprefix $(B)/android-fs/,$(ANDROID_FS_TESTS)): $(B)/android-fs/%: %.c ../hle_fs.c $(ANDROID_FS_SRC) $(ANDROID_FS_HEADERS) $(GAME_H) | $(B)/android-fs
	$(CLANG) $(ANDROID_FS_FLAGS) -o $@ $< $(ANDROID_FS_SRC)

$(B)/t_fdstat: t_fdstat.c ../hle_fdstat.c ../hle.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_fdstat.c

.PHONY: fdstat
fdstat: $(B)/t_fdstat
	TMPDIR="$(abspath $(B))" $(B)/t_fdstat
run: fdstat

