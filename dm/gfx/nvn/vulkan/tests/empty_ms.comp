#version 450
layout(local_size_x=1) in;
layout(binding=0, rgba32f) uniform image2DMS floatSink;
layout(binding=1, rgba32ui) uniform uimage2DMSArray unsignedSink;
layout(binding=2) uniform sampler2DMS emptyFloat;
layout(binding=3) uniform isampler2DMS emptySigned;
layout(binding=4) uniform usampler2DMSArray emptyUnsigned;
layout(binding=5) uniform sampler2DMS realDepth;
layout(binding=6) uniform sampler2DShadow emptyShadow;
layout(binding=7, std430) buffer Results { uvec4 values[8]; };
void main() {
    vec4 floats = vec4(0);
    ivec4 integers = ivec4(0);
    uvec4 unsigneds = uvec4(0);
    for (int sampleIndex=0; sampleIndex<4; sampleIndex++) {
        floats += texelFetch(emptyFloat, ivec2(0), sampleIndex);
        integers += texelFetch(emptySigned, ivec2(0), sampleIndex);
        unsigneds += texelFetch(emptyUnsigned, ivec3(0), sampleIndex);
    }
    values[0] = floatBitsToUint(floats);
    values[1] = uvec4(integers);
    values[2] = unsigneds;
    values[3] = floatBitsToUint(texelFetch(realDepth, ivec2(0), 3));
    values[4] = uvec4(100 * texture(emptyShadow, vec3(0.5, 0.5, 0.25)));
    values[5] = uvec4(textureSamples(emptyFloat), textureSamples(emptySigned),
        imageSamples(floatSink), imageSamples(unsignedSink));
    imageStore(floatSink, ivec2(0), 3, vec4(17, 18, 19, 20));
    imageStore(unsignedSink, ivec3(0), 1, uvec4(41, 42, 43, 44));
    memoryBarrierImage();
    values[6] = uvec4(imageLoad(floatSink, ivec2(0), 3));
    values[7] = imageLoad(unsignedSink, ivec3(0), 1);
}
