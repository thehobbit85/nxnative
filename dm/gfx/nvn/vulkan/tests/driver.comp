#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std140) uniform Driver { uvec4 rows[64]; } c0;
layout(set = 0, binding = 1, std430) buffer Result { uvec4 values[]; } result;
void main() {
    if (all(equal(gl_GlobalInvocationID, uvec3(0)))) {
        result.values[0] = c0.rows[0x200 / 16];
        result.values[1] = uvec4(gl_NumWorkGroups, 0);
        result.values[2] = c0.rows[0x210 / 16 + 7];
        result.values[3] = c0.rows[0x310 / 16];
    }
}
