#version 450
layout(binding=1, std140) uniform Parameters { uint index; float lod; vec2 coordinate; };
#ifdef FRAGMENT
layout(location=0) out vec4 value;
#else
layout(local_size_x=1) in;
layout(binding=2, std430) buffer Results { vec4 value; };
#endif
#ifdef SEPARATE
layout(binding=0) uniform texture2D source[32];
layout(binding=3) uniform sampler filtering[32];
#define SAMPLE(i) sampler2D(source[i], filtering[((i) + 1) % 32])
#else
layout(binding=0) uniform sampler2D sampled[32];
#define SAMPLE(i) sampled[i]
#endif
#ifdef QUERY
#define READ(i) vec4(textureQueryLod(SAMPLE(i), position), 0, 1)
#elif defined(FRAGMENT)
#define READ(i) texture(SAMPLE(i), position)
#else
#define READ(i) textureLod(SAMPLE(i), position, lod)
#endif
void main() {
    vec2 position = coordinate;
#ifdef FRAGMENT
    position += (gl_FragCoord.xy - vec2(.5)) * exp2(lod) / vec2(textureSize(SAMPLE(0), 0));
#endif
#ifdef CONSTANT_INDEX
    value = READ(0) + READ(1) * 2 + READ(2) * 4;
#else
    value = READ(index);
#endif
}
