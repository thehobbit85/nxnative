#version 450
layout(local_size_x=1) in;
#ifdef ARRAY
#define TEXTURE texture2DArray
#define SAMPLER sampler2DArray
#define COORDINATE vec3(coordinate.xy, coordinate.w)
#else
#define TEXTURE texture2D
#define SAMPLER sampler2D
#define COORDINATE coordinate.xy
#endif
#ifdef SEPARATE
layout(binding=0) uniform TEXTURE source;
layout(binding=3) uniform sampler filtering;
#define sampled SAMPLER(source, filtering)
#else
layout(binding=0) uniform SAMPLER sampled;
#endif
layout(binding=1, std140) uniform Coordinates { vec4 coordinate; };
layout(binding=2, std430) buffer Results { vec4 value; };
void main() {
#ifdef GRADIENTS
    vec2 scale = exp2(coordinate.z) / vec2(textureSize(sampled, 0).xy);
#ifdef OFFSET
    value = textureGradOffset(sampled, COORDINATE, vec2(scale.x,0), vec2(0,scale.y), ivec2(1,-1));
#else
    value = textureGrad(sampled, COORDINATE, vec2(scale.x,0), vec2(0,scale.y));
#endif
#else
#ifdef OFFSET
    value = textureLodOffset(sampled, COORDINATE, coordinate.z, ivec2(1,-1));
#else
    value = textureLod(sampled, COORDINATE, coordinate.z);
#endif
#endif
}
