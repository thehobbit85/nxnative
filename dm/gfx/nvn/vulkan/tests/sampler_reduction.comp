#version 450
#ifndef FRAGMENT
layout(local_size_x=1) in;
#endif
#ifdef ONE_ROW
#ifdef ARRAY
#define TEXTURE texture1DArray
#define SAMPLER sampler1DArray
#define COORDINATE vec2(position, coordinate.w)
#define EXTENT textureSize(sampled, 0).x
#else
#define TEXTURE texture1D
#define SAMPLER sampler1D
#define COORDINATE position
#define EXTENT textureSize(sampled, 0)
#endif
#define SPATIAL float
#define TEXEL_OFFSET 1
#define DX scale
#define DY 0.0
#elif defined(VOLUME)
#define TEXTURE texture3D
#define SAMPLER sampler3D
#define COORDINATE position
#define SPATIAL vec3
#define EXTENT textureSize(sampled, 0)
#define TEXEL_OFFSET ivec3(1,-1,1)
#define DX vec3(0,0,scale.z)
#define DY vec3(0,scale.y,0)
#elif defined(ARRAY)
#define TEXTURE texture2DArray
#define SAMPLER sampler2DArray
#define COORDINATE vec3(position, coordinate.w)
#else
#define TEXTURE texture2D
#define SAMPLER sampler2D
#define COORDINATE position
#endif
#if !defined(VOLUME) && !defined(ONE_ROW)
#define SPATIAL vec2
#define EXTENT textureSize(sampled, 0).xy
#define TEXEL_OFFSET ivec2(1,-1)
#define DX vec2(scale.x,0)
#define DY vec2(0,scale.y)
#endif
#ifdef PROJECTED
#undef COORDINATE
#ifdef ONE_ROW
#define COORDINATE vec2(position * -2, -2)
#elif defined(VOLUME)
#define COORDINATE vec4(position * -2, -2)
#else
#define COORDINATE vec4(position * -2, 7, -2)
#endif
#define SAMPLE textureProj
#define SAMPLE_OFFSET textureProjOffset
#define SAMPLE_LOD textureProjLod
#define SAMPLE_LOD_OFFSET textureProjLodOffset
#define SAMPLE_GRAD textureProjGrad
#define SAMPLE_GRAD_OFFSET textureProjGradOffset
#else
#define SAMPLE texture
#define SAMPLE_OFFSET textureOffset
#define SAMPLE_LOD textureLod
#define SAMPLE_LOD_OFFSET textureLodOffset
#define SAMPLE_GRAD textureGrad
#define SAMPLE_GRAD_OFFSET textureGradOffset
#endif
#ifdef SEPARATE
layout(binding=0) uniform TEXTURE source;
layout(binding=3) uniform sampler filtering;
#define sampled SAMPLER(source, filtering)
#else
layout(binding=0) uniform SAMPLER sampled;
#endif
layout(binding=1, std140) uniform Coordinates { vec4 coordinate; };
#ifdef FRAGMENT
layout(location=0) out vec4 value;
#else
layout(binding=2, std430) buffer Results { vec4 value; };
#endif
void main() {
#ifdef ONE_ROW
    float position = coordinate.x;
#elif defined(VOLUME)
    vec3 position = vec3(coordinate.xy, coordinate.w);
#else
    vec2 position = coordinate.xy;
#endif
#ifdef FRAGMENT
#ifdef BIAS
    const float bias = 1;
#else
    const float bias = 0;
#endif
    SPATIAL scale = exp2(coordinate.z - bias) / SPATIAL(EXTENT);
#ifdef ONE_ROW
    position += (gl_FragCoord.x - .5) * scale;
#elif defined(VOLUME)
    position.zy += (gl_FragCoord.xy - vec2(.5)) * scale.zy;
#else
    position += (gl_FragCoord.xy - vec2(.5)) * scale;
#endif
#ifdef QUERY
    value = vec4(textureQueryLod(sampled, position), 0, 1);
#else
#ifdef OFFSET
#ifdef BIAS
    value = SAMPLE_OFFSET(sampled, COORDINATE, TEXEL_OFFSET, bias);
#else
    value = SAMPLE_OFFSET(sampled, COORDINATE, TEXEL_OFFSET);
#endif
#else
#ifdef BIAS
    value = SAMPLE(sampled, COORDINATE, bias);
#else
    value = SAMPLE(sampled, COORDINATE);
#endif
#endif
#endif
#else
#ifdef GRADIENTS
    SPATIAL scale = exp2(coordinate.z) / SPATIAL(EXTENT);
#ifdef OFFSET
    value = SAMPLE_GRAD_OFFSET(sampled, COORDINATE, DX, DY, TEXEL_OFFSET);
#else
    value = SAMPLE_GRAD(sampled, COORDINATE, DX, DY);
#endif
#else
#ifdef OFFSET
    value = SAMPLE_LOD_OFFSET(sampled, COORDINATE, coordinate.z, TEXEL_OFFSET);
#else
    value = SAMPLE_LOD(sampled, COORDINATE, coordinate.z);
#endif
#endif
#endif
}
