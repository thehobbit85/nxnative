#version 450
layout(local_size_x=1) in;
layout(binding=0, r32ui) uniform uimage2D images[2];
layout(binding=1, rgba16f) uniform image3D floatSink;
layout(binding=2, rgba32i) uniform iimage2DArray signedSink;
layout(binding=3, rgba32ui) uniform uimage2D unsignedSink;
layout(binding=4, r32ui) uniform readonly uimage2D emptyRead;
layout(binding=5) uniform usampler2D emptySample;
layout(binding=6, std430) buffer Results { uvec4 sampled; uint reached; };
void main() {
    // The unused first array element must not cancel work on the second.
    uint previous = imageLoad(images[1], ivec2(0)).r;
    imageStore(images[1], ivec2(0), uvec4(previous + 7));
    imageAtomicAdd(images[0], ivec2(0), 3);
    imageStore(floatSink, ivec3(0), vec4(0.5));
    imageStore(signedSink, ivec3(0), ivec4(-71));
    imageStore(unsignedSink, ivec2(0), uvec4(93));
    memoryBarrierImage();
    sampled = texelFetch(emptySample, ivec2(0), 0);
    reached = 123 + imageLoad(emptyRead, ivec2(0)).r;
}
