#version 450
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x=32) in;
layout(binding=0) uniform texture2D textures[301];
layout(binding=1) uniform sampler samplers[301];
layout(binding=2,std430) buffer Results { uint output_words[]; };
void main() {
    uint lane=gl_LocalInvocationIndex;
    output_words[2*lane]=floatBitsToUint(textureLod(sampler2D(textures[nonuniformEXT(45+lane)],samplers[nonuniformEXT(173+lane)]),vec2(.5),0).x);
    output_words[2*lane+1]=floatBitsToUint(textureLod(sampler2D(textures[nonuniformEXT(45+lane)],samplers[nonuniformEXT(173+lane)]),vec2(1.5,.5),0).x);
}
