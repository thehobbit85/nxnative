#version 450
layout(local_size_x=1) in;
layout(binding=0) uniform samplerCube cube;
layout(binding=1) uniform samplerCubeArray cubes;
layout(binding=2) uniform sampler2DArray layers;
layout(binding=3, std430) writeonly buffer Output { ivec4 values[]; };
const vec3 directions[] = vec3[](vec3(1,0,0), vec3(-1,0,0), vec3(0,1,0),
                                 vec3(0,-1,0), vec3(0,0,1), vec3(0,0,-1));
void main() {
    int i = int(gl_GlobalInvocationID.x);
    int count = textureSize(cubes, 0).z;
    int faces = textureSize(layers, 0).z;
    int layer = min(i, faces - 1);
    vec3 direction = directions[i % 6];
    values[i] = ivec4(textureLod(cube, direction, 0.0).r,
                      textureLod(cubes, vec4(direction, min(i / 6, count - 1)), 0.0).r,
                      texelFetch(layers, ivec3(0, 0, layer), 0).r, textureQueryLevels(layers));
    if (i == 0) values[18] = ivec4(textureSize(cube, 0).x, count, faces, textureSize(layers, 0).x);
}
